# Provedor do modelo de chat: openai ou google (Gemini). Basta a chave do provedor escolhido.
# Sem chave, a análise da pergunta cai nas regras e a busca continua funcionando (só a síntese fica indisponível).
LLM_PROVIDER=openai
OPENAI_API_KEY=sua-chave-aqui
GOOGLE_API_KEY=sua-chave-aqui
CHAT_MODEL=gpt-5.6-luna

# Juiz da avaliação (python -m voc_rag.cli evaluate --judge). Use outro provedor para reduzir o viés de autopreferência.
# JUDGE_PROVIDER=google
# JUDGE_MODEL=gemini-3.7-flash

# Defina só para modelos que aceitam temperatura; modelos de raciocínio recusam o parâmetro.
# LLM_TEMPERATURE=0

# Embeddings: local (intfloat/multilingual-e5-small, gratuito e offline), openai (text-embedding-3-small)
# ou google (gemini-embedding-2-preview). Cada modelo tem seu índice. Ao trocar, rode python -m voc_rag.cli index.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=

# Banco vetorial: faiss (busca exata com pré-filtro de metadados) ou chroma.
VECTOR_STORE=faiss

# Similaridade mínima. Vazio usa o padrão do provedor de embeddings (local 0.80, openai e google 0.40).
MIN_SIMILARITY=

# Reranker: cross_encoder (local, determinístico, sem custo por consulta) ou llm (nota de 0 a 3 dada pelo CHAT_MODEL).
RERANKER=cross_encoder
CROSS_ENCODER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Logit mínimo do cross-encoder para a avaliação contar como evidência.
MIN_RERANK_SCORE=-1.0
# Modelo do rerank quando RERANKER=llm. Vazio usa o CHAT_MODEL.
RERANK_MODEL=

# Componentes da recuperação. O padrão vem da ablação em docs/avaliacao.md.
USE_MULTI_QUERY=true
USE_BM25=true
USE_RERANK=true
